{
  "name": "agno-frontend-sdk",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "examples/*", "e2e/*"],
  "scripts": {
    "generate": "bun run --filter '@rodrigocoliveira/agno-api' generate",
    "agentos": "bun run --filter agentos-e2e dev",
    "demo:server": "bun run --filter demo-agentos dev",
    "demo:tokens": "bun run --filter demo-agentos tokens",
    "demo:web": "bun run --filter demo-react dev",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "build": "bun run --filter '@rodrigocoliveira/agno-api' build && bun run --filter '@rodrigocoliveira/agno-hooks' build",
    "test": "bun run --filter './packages/*' test",
    "check:guide-excerpts": "bun run scripts/check-guide-excerpts.ts",
    "check:demo-catalog": "bun run scripts/check-demo-catalog.ts",
    "test:e2e": "AGNO_URL=${AGNO_URL:-http://localhost:7777} bun test packages/agno-api/test/e2e packages/agno-hooks/test/e2e",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@types/bun": "^1.4.1",
    "typescript": "^5.9.3"
  }
}
