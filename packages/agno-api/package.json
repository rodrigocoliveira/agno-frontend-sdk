{
  "name": "@rodrigocoliveira/agno-api",
  "version": "0.0.0",
  "description": "Typed, stateless client for every AgentOS v3 route",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "generate": "bun run scripts/generate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsup",
    "test": "bun test"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": { "access": "public" }
}
