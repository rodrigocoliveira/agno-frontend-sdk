# Copy this file to .env and fill in what you need. .env is gitignored — never commit real keys.
# Every value here is optional; the server falls back to the default shown when a line is unset.

# When set, the demo uses OpenAI. When unset, it falls back to a local Ollama model instead.
OPENAI_API_KEY=

# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_MODEL=llama3.2
# AGNO_PORT=7777
# JWT_SECRET=demo-secret-change-me
# WEB_ORIGIN=http://localhost:5173
